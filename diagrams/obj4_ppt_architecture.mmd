    classDef users fill:#E9C46A,stroke:#B5892E,color:#1D1D1D,stroke-width:2px,rx:8,ry:8
    classDef agri fill:#5C7A29,stroke:#3A4F1A,color:#FFFFFF,stroke-width:2px,rx:8,ry:8
    classDef grp fill:#F4F7FA,stroke:#A9C4D8,stroke-width:1.5px,color:#0B1F33,font-weight:bold

    class GH source
    class KG compute
    class VC,HF present
